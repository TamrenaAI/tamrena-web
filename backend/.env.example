# AWS DynamoDB Configuration
AWS_REGION=eu-north-1
DYNAMODB_TABLE_NAME=workout_users
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# JWT Configuration (must match Tamreena_AI's JWT_SECRET)
JWT_SECRET=your_jwt_secret_here

# Tamreena_AI proxy configuration
WORKOUT_API_URL=http://localhost:8001

# Nutrition-Plan-Generation proxy configuration
# Local dev default shown below; in the deployed AWS environment this is
# NUTRITION_API_URL=http://nutrition-agent.fitness-app-prod.local:8000
# (an internal Cloud Map/VPC hostname, only reachable from inside that network).
NUTRITION_API_URL=http://localhost:8000
