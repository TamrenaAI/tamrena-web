# Must match Tamreena_AI's own JWT_SECRET exactly — see
# Tamreena_AI/docs/superpowers/specs/2026-07-25-bff-auth-handoff-design.md
JWT_SECRET=

# Google OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0
# Client IDs). Used by BOTH the backend (to verify ID token audience) and
# the frontend (to initialize Google Identity Services) - must be the same
# value in both places.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Enables POST /auth/dev-login for local/E2E testing. NEVER set true
# anywhere but a local dev machine.
ALLOW_DEV_LOGIN=false

# This service's OWN MongoDB - never shared with Tamreena_AI's.
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=tamreena_web
