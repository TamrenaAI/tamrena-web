# Must match Tamreena_AI's own JWT_SECRET exactly — see
# Tamreena_AI/docs/superpowers/specs/2026-07-25-bff-auth-handoff-design.md
JWT_SECRET=

# OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0 Client IDs)
GOOGLE_OAUTH_CLIENT_ID=

# Enables POST /auth/dev-login for local/E2E testing. NEVER set true
# anywhere but a local dev machine.
ALLOW_DEV_LOGIN=false
